{
  "expo": {
    "name": "taekus-demo",
    "slug": "taekus-demo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/taekus-splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#1B2B4B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.taekusdemo"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.taekusdemo"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-splash-screen"
    ]
  }
}
